{
  "name": "flomotion-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "flomotion": "tsx packages/cli/src/bin.ts",
    "gen:docs": "tsx packages/cli/src/bin.ts docs --out docs/components --skill-ref skills/flomotion-studio/references/components.md"
  },
  "devDependencies": {
    "@flomotion/components": "workspace:*",
    "@flomotion/core": "workspace:*",
    "@flomotion/render": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "gsap": "3.14.2",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fontkit": "^2.0.4",
    "hyperframes": "0.8.186",
    "puppeteer-core": "^25.15.0",
    "ts-morph": "^28.0.0"
  }
}
